# ===== GitHub（后端用来触发 workflow + 查状态）=====
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=your-username/your-repo
GITHUB_REF=main

# ===== 华为云 SWR（后端只用来拼最终 pull 地址，不参与 push）=====
SWR_REGISTRY=swr.cn-east-3.myhuaweicloud.com
SWR_NAMESPACE=cloud-gt3k

# ===== 服务 =====
HOST=127.0.0.1
PORT=8000
DB_PATH=mirror.db